@model ButceYonet.Application.Infrastructure.MailTemplates.SubscriptionReminderTemplateModel
<table width="100%" cellpadding="0" cellspacing="0" style="background-color:#f6f7fb;">
    <tr>
        <td>
            <table width="650" cellpadding="0" cellspacing="0" align="center" style="margin-bottom:30px;">
                <tr>
                    <td align="center">
                        <h2 style="margin:0; color:#22c55e;"> Bütçe Yönet </h2>
                    </td>
                </tr>
            </table>
            <table width="650" cellpadding="0" cellspacing="0" align="center" style="background-color:#ffffff; border-radius:8px;">
                <tr>
                    <td style="padding:30px; color:#333333; font-size:13px; line-height:1.7; letter-spacing:0.5px;">
                        <p style="margin-top:0;">Merhaba <strong>@Model.UserName</strong>,</p>
                        <p>
                            Abonelik/fatura takibinizde dikkatinizi bekleyen kayıtlar var.
                        </p>

                        @if (Model.OverdueItems.Any())
                        {
                            <table width="100%" cellpadding="12" cellspacing="0" style="background-color:#fef2f2; border:1px solid #fecaca; border-radius:6px; margin:15px 0;">
                                <tr>
                                    <td>
                                        <p style="margin:0 0 8px 0; font-weight:bold; color:#b91c1c;">Vadesi geçmiş abonelikleriniz</p>
                                        <table width="100%" cellpadding="6" cellspacing="0">
                                            @foreach (var item in Model.OverdueItems)
                                            {
                                                <tr>
                                                    <td style="border-bottom:1px solid #fecaca;">
                                                        <strong>@item.Name</strong>
                                                        <span style="color:#7f1d1d; font-size:12px;"> — @Math.Abs(item.DaysDiff) gün gecikti</span>
                                                    </td>
                                                    <td style="border-bottom:1px solid #fecaca; text-align:right; font-weight:500; color:#b91c1c;">
                                                        @(item.Amount.HasValue
                                                            ? (item.IsSymbolRight ? item.Amount.Value.ToString("N2") + " " + item.CurrencySymbol : item.CurrencySymbol + " " + item.Amount.Value.ToString("N2"))
                                                            : "Tutar belirsiz")
                                                    </td>
                                                </tr>
                                            }
                                        </table>
                                    </td>
                                </tr>
                            </table>
                        }

                        @if (Model.UpcomingItems.Any())
                        {
                            <table width="100%" cellpadding="12" cellspacing="0" style="background-color:#fffbeb; border:1px solid #fde68a; border-radius:6px; margin:15px 0;">
                                <tr>
                                    <td>
                                        <p style="margin:0 0 8px 0; font-weight:bold; color:#b45309;">Vadesi yaklaşan abonelikleriniz</p>
                                        <table width="100%" cellpadding="6" cellspacing="0">
                                            @foreach (var item in Model.UpcomingItems)
                                            {
                                                <tr>
                                                    <td style="border-bottom:1px solid #fde68a;">
                                                        <strong>@item.Name</strong>
                                                        <span style="color:#92400e; font-size:12px;">
                                                            — @(item.DaysDiff == 0 ? "bugün" : item.DaysDiff + " gün sonra") vadesi doluyor
                                                        </span>
                                                    </td>
                                                    <td style="border-bottom:1px solid #fde68a; text-align:right; font-weight:500; color:#b45309;">
                                                        @(item.Amount.HasValue
                                                            ? (item.IsSymbolRight ? item.Amount.Value.ToString("N2") + " " + item.CurrencySymbol : item.CurrencySymbol + " " + item.Amount.Value.ToString("N2"))
                                                            : "Tutar belirsiz")
                                                    </td>
                                                </tr>
                                            }
                                        </table>
                                    </td>
                                </tr>
                            </table>
                        }

                        <p style="margin-bottom:0;">
                            Detayları ve ödeme işaretlemeyi uygulama üzerinden yapabilirsiniz.<br>
                            <strong>Bütçe Yönet Ekibi</strong>
                        </p>
                    </td>
                </tr>
            </table>
            <table width="650" cellpadding="0" cellspacing="0" align="center" style="margin-top:30px;">
                <tr>
                    <td align="center" style="font-size:12px; color:#999999;">
                        <p style="margin-bottom:4px;"> © @Model.Year Bütçe Yönet </p>
                        <p style="margin-bottom:0;"> Bu e-posta otomatik olarak gönderilmiştir. </p>
                    </td>
                </tr>
            </table>
        </td>
    </tr>
</table>
