@model ButceYonet.Application.Infrastructure.MailTemplates.RecurringTransactionsProcessedTemplateModel
<table width="100%" cellpadding="0" cellspacing="0" style="background-color:#f6f7fb;">
    <tr>
        <td>
            <!-- Logo / Header -->
            <table width="650" cellpadding="0" cellspacing="0" align="center" style="margin-bottom:30px;">
                <tr>
                    <td align="center">
                        <h2 style="margin:0; color:#22c55e;"> Bütçe Yönet </h2>
                    </td>
                </tr>
            </table>
            <!-- Content -->
            <table width="650" cellpadding="0" cellspacing="0" align="center" style="background-color:#ffffff; border-radius:8px;">
                <tr>
                    <td style="padding:30px; color:#333333; font-size:13px; line-height:1.7; letter-spacing:0.5px;">
                        <p style="margin-top:0;">@await Model.Text("Common.GreetingWithName", Model.UserName)</p>
                        <p>@await Model.Text("RecurringTransactionsProcessed.Intro", Model.ProcessedDate)</p>
                        @if (Model.Items.Any())
                        {
                            <p>@await Model.Text("RecurringTransactionsProcessed.ItemsTitle")</p>
                            <table width="100%" cellpadding="8" cellspacing="0" style="border:1px solid #e5e7eb; border-radius:6px; margin:15px 0;">
                                <tr style="background-color:#f9fafb;">
                                    <td style="font-weight:bold; border-bottom:1px solid #e5e7eb;">@await Model.Text("RecurringTransactionsProcessed.ColumnItem")</td>
                                    <td style="font-weight:bold; border-bottom:1px solid #e5e7eb;">@await Model.Text("RecurringTransactionsProcessed.ColumnType")</td>
                                    <td style="font-weight:bold; border-bottom:1px solid #e5e7eb;">@await Model.Text("RecurringTransactionsProcessed.ColumnDescription")</td>
                                    <td style="font-weight:bold; border-bottom:1px solid #e5e7eb; text-align:right;">@await Model.Text("RecurringTransactionsProcessed.ColumnAmount")</td>
                                </tr>
                                @foreach (var item in Model.Items)
                                {
                                    <tr>
                                        <td style="border-bottom:1px solid #f3f4f6;">@item.Name</td>
                                        <td style="border-bottom:1px solid #f3f4f6;">
                                            <span style="color:@(item.IsIncome ? "#16a34a" : "#dc2626"); font-weight:500;">@await Model.Text(item.IsIncome ? "Common.Income" : "Common.Expense")</span>
                                        </td>
                                        <td style="border-bottom:1px solid #f3f4f6; font-size:12px; color:#6b7280;">@(string.IsNullOrWhiteSpace(item.Description) ? "—" : item.Description)</td>
                                        <td style="border-bottom:1px solid #f3f4f6; text-align:right; font-weight:500; color:@(item.IsIncome ? "#16a34a" : "#dc2626");">
                                            @Model.FormatAmount(item.Amount, item.CurrencySymbol, item.IsSymbolRight)
                                        </td>
                                    </tr>
                                }
                            </table>
                        }
                        <p style="margin-bottom:0;">
                            @await Model.Text("Common.SeeDetailsInApp")<br>
                            <strong>@await Model.Text("Common.TeamSignature")</strong>
                        </p>
                    </td>
                </tr>
            </table>
            <!-- Footer -->
            <table width="650" cellpadding="0" cellspacing="0" align="center" style="margin-top:30px;">
                <tr>
                    <td align="center" style="font-size:12px; color:#999999;">
                        <p style="margin-bottom:4px;"> © @Model.Year Bütçe Yönet </p>
                        <p style="margin-bottom:0;"> @await Model.Text("Common.AutoSentNotice") </p>
                    </td>
                </tr>
            </table>
        </td>
    </tr>
</table>
