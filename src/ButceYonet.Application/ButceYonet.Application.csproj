<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <RuntimeFrameworkVersion>10.0.0</RuntimeFrameworkVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="DotBoil" Version="2.0.1" />
      <PackageReference Include="DotBoil.Caching" Version="2.0.1" />
      <PackageReference Include="DotBoil.Cors" Version="2.0.1" />
      <PackageReference Include="DotBoil.EFCore" Version="2.0.1" />
      <PackageReference Include="DotBoil.FCM" Version="1.0.0" />
      <PackageReference Include="DotBoil.Email" Version="2.0.1" />
      <PackageReference Include="DotBoil.Localization" Version="2.0.1" />
      <PackageReference Include="DotBoil.Logging" Version="2.0.1" />
      <PackageReference Include="DotBoil.Mapper" Version="2.0.1" />
      <PackageReference Include="DotBoil.MassTransit" Version="2.0.1" />
      <PackageReference Include="DotBoil.Mediator" Version="2.0.1" />
      <PackageReference Include="DotBoil.Parameter" Version="2.0.1" />
      <PackageReference Include="DotBoil.TemplateEngine" Version="2.0.1" />
      <PackageReference Include="DotBoil.Validator" Version="2.0.1" />
      <PackageReference Include="DotBoil.Validator.Mediator" Version="2.0.1" />
      <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.17.0" />
    </ItemGroup>

    <ItemGroup>
      <None Remove="Infrastructure\MailTemplates\UserCreatedMailTemplate.cshtml" />
      <EmbeddedResource Include="Infrastructure\MailTemplates\UserCreatedMailTemplate.cshtml">
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      </EmbeddedResource>
      <None Remove="Infrastructure\MailTemplates\ForgotPasswordOtpCodeCreatedTemplate.cshtml" />
      <EmbeddedResource Include="Infrastructure\MailTemplates\ForgotPasswordOtpCodeCreatedTemplate.cshtml">
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      </EmbeddedResource>
      <None Remove="Infrastructure\MailTemplates\RecurringTransactionsProcessedTemplate.cshtml" />
      <EmbeddedResource Include="Infrastructure\MailTemplates\RecurringTransactionsProcessedTemplate.cshtml">
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      </EmbeddedResource>
      <None Remove="Infrastructure\MailTemplates\RecurringTransactionEndedTemplate.cshtml" />
      <EmbeddedResource Include="Infrastructure\MailTemplates\RecurringTransactionEndedTemplate.cshtml">
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      </EmbeddedResource>
      <None Remove="Infrastructure\MailTemplates\SubscriptionReminderTemplate.cshtml" />
      <EmbeddedResource Include="Infrastructure\MailTemplates\SubscriptionReminderTemplate.cshtml">
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      </EmbeddedResource>
    </ItemGroup>

</Project>
